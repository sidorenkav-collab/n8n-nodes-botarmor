{
  "name": "n8n-nodes-botarmor",
  "version": "0.1.2",
  "description": "n8n node for BotArmor AI: crash-test your chatbot (red-teaming audit), wait for the grade and stop a workflow when it is below your threshold.",
  "keywords": [
    "n8n-community-node-package",
    "botarmor",
    "chatbot",
    "red-teaming",
    "ai-security",
    "audit"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sidorenkav-collab/n8n-nodes-botarmor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorenkav-collab/n8n-nodes-botarmor.git"
  },
  "bugs": {
    "url": "https://github.com/sidorenkav-collab/n8n-nodes-botarmor/issues"
  },
  "author": {
    "name": "BotArmor AI",
    "email": "sidorenkav@gmail.com"
  },
  "main": "index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').cpSync('icons','dist/icons',{recursive:true})\"",
    "lint": "n8n-node lint",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BotArmorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/BotArmor/BotArmor.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.5",
    "n8n-workflow": "2.16.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
